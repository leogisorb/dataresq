# Öffentliche Site-URL (Canonical, Open Graph, Sitemap)
# Production: immer https://www.rsqdata.de (kein Redirect-Split apex ↔ www)
NEXT_PUBLIC_SITE_URL=https://www.rsqdata.de

# Google Search Console — HTML-Tag-Verifizierung (optional)
# Nach Verifizierung in GSC hier den Content-Wert des meta-Tags eintragen
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional GA4 Measurement ID (G-XXXXXXXX) — nur nach Cookie-Einwilligung geladen
NEXT_PUBLIC_GA_ID=

# Resend API — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Absender-Adresse (Domain muss in Resend verifiziert sein)
RESEND_FROM_EMAIL=noreply@rsqdata.de

# Interne E-Mail-Adresse für neue Anfragen (sollte SITE.email entsprechen)
CONTACT_EMAIL=info@rsqdata.de

# Sanity CMS — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
