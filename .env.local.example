# Öffentliche Site-URL (Canonical, Open Graph, Sitemap)
NEXT_PUBLIC_SITE_URL=https://www.rsqdata.de

# Resend API — https://resend.com/api-keys
RESEND_API_KEY=re_...

# Absender-Adresse (Domain muss in Resend verifiziert sein)
RESEND_FROM_EMAIL=noreply@rsqdata.de

# Interne E-Mail-Adresse für neue Anfragen (sollte SITE.email entsprechen)
CONTACT_EMAIL=info@rsqdata.de

# Sanity CMS — https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
